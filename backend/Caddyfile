# Caddy: puerta de entrada HTTPS de HoloMarket en la EC2.
# - Obtiene y renueva solo el certificado de Let's Encrypt para DOMINIO.
# - /api/* va al backend Spring Boot (contenedor api, puerto 8080 de la red interna).
# - Todo lo demás se pide al sitio estático del bucket S3 (el front sigue alojado en S3).
# Se usa en lugar de CloudFront porque el Learner Lab no permite crear distribuciones.

{$DOMINIO} {
	encode gzip

	# Cabeceras de seguridad para todas las respuestas (sitio y API).
	header {
		# El navegador recuerda por un año que este sitio solo se usa con HTTPS.
		Strict-Transport-Security "max-age=31536000"
		# No adivinar tipos de archivo, no permitir que otro sitio nos meta en un iframe.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# CSP: solo nuestro JavaScript; tipografías de Google; imágenes de cartas por https;
		# la API en el mismo dominio y el dólar desde mindicador.cl y open.er-api.com.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://mindicador.cl https://open.er-api.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# No anunciar qué servidores hay detrás (Caddy, AmazonS3).
		-Server
		defer
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		# React Router: /catalogo, /carrito... no existen como archivos en S3. Se pide index.html
		# (con estado 200) y React muestra la vista. Los archivos reales (assets, favicon) pasan tal cual.
		@spa not path /assets/* /favicon.svg
		rewrite @spa /index.html
		reverse_proxy http://{$FRONT_S3_HOST} {
			# S3 elige el bucket por el nombre del host: hay que enviarle el suyo, no el de Caddy.
			header_up Host {$FRONT_S3_HOST}
		}
	}
}

# Compatibilidad: la API también responde por http://IP/api (pruebas con curl y el link antiguo).
http://{$IP_PUBLICA} {
	reverse_proxy api:8080
}
