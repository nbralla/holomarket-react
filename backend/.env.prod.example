# Copiar como .env.prod y completar. NUNCA subir .env.prod a GitHub.
# Evita el símbolo $ en los valores (Docker Compose lo interpreta).
DB_NAME=holomarket
DB_USER=holomarket
DB_PASSWORD=CAMBIAR_password_larga
MYSQL_ROOT_PASSWORD=CAMBIAR_otra_password_larga
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_base64_48
CORS_ORIGINS=https://holomarket.TU-IP-CON-GUIONES.sslip.io,http://NOMBRE-BUCKET.s3-website-us-east-1.amazonaws.com
# HTTPS con Caddy: dominio gratuito de sslip.io que apunta a la IP elástica (3.218.125.149 -> 3-218-125-149)
DOMINIO=holomarket.TU-IP-CON-GUIONES.sslip.io
IP_PUBLICA=TU_ELASTIC_IP
FRONT_S3_HOST=NOMBRE-BUCKET.s3-website-us-east-1.amazonaws.com
ADMIN_PASSWORD=CAMBIAR
DEMO_USER_PASSWORD=CAMBIAR
# Opcional: imágenes y precios de mercado de las cartas (https://apitcg.com/platform/api-key)
APITCG_KEY=
SWAGGER_ENABLED=false
