{
  "name": "holomarket-react",
  "private": true,
  "version": "1.0.0",
  "description": "HoloMarket: marketplace chileno de cartas TCG hecho con React + TypeScript + Vite (DSY1104 Desarrollo FullStack II, Duoc UC).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && karma start karma.conf.cjs",
    "api": "json-server --watch db.json --host 127.0.0.1 --port 3000",
    "test:logica": "vitest run",
    "test:componentes": "karma start karma.conf.cjs",
    "test:componentes:ver": "karma start karma.conf.cjs --browsers Chrome --no-single-run",
    "test:logica:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild-plugin-istanbul": "^0.3.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jasmine-core": "^7.0.2",
    "json-server": "0.17.4",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-esbuild": "^2.3.0",
    "karma-jasmine": "^5.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
